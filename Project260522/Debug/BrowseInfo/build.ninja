##IAR Ninja build file


#Rules
rule COMPDB_GEN
  command = D$:\IARforARM\common\bin\ClangdCompDbGenerator.exe $gencommand -f "$rspfile_name"
  description = Building $out...
  rspfile = $rspfile_name
  rspfile_content = $flags

rule COMPDB_LINK
  command = D$:\IARforARM\common\bin\ClangdCompDbLinker.exe -f "$rspfile_name"
  description = Building $out...
  rspfile = $rspfile_name
  rspfile_content = $flags



#Build steps
build D$:\STM32_ARM_IAR\Project260522\Debug\BrowseInfo\main.c.json : COMPDB_GEN 
    flags = D$:\IARforARM\arm\bin\iccarm.exe D$:\STM32_ARM_IAR\Project260522\main.c -o D$:\STM32_ARM_IAR\Project260522\Debug\Obj\ --no_cse --no_unroll --no_inline --no_code_motion --no_tbaa --no_clustering --no_scheduling --debug --endian=little --cpu=Cortex-M3 --fpu=None --dlib_config D$:\IARforARM\arm\inc\c\DLib_Config_Normal.h -Ol -e
    gencommand = -output_file D$:\STM32_ARM_IAR\Project260522\Debug\BrowseInfo\main.c.json -icc_path D$:\IARforARM\arm\bin\iccarm.exe -source_file D$:\STM32_ARM_IAR\Project260522\main.c -work_dir D$:\STM32_ARM_IAR\Project260522 -keyword_map_path D$:\IARforARM\common\config\ClangdConfig.json -object_file D$:\STM32_ARM_IAR\Project260522\Debug\Obj\main.o
    rspfile_name = D$:\STM32_ARM_IAR\Project260522\Debug\BrowseInfo\main.c.json.rsp

build D$:\STM32_ARM_IAR\Project260522\Debug\compile_commands.json : COMPDB_LINK D$:\STM32_ARM_IAR\Project260522\Debug\BrowseInfo\main.c.json
    flags = -o D$:\STM32_ARM_IAR\Project260522\Debug\compile_commands.json D$:\STM32_ARM_IAR\Project260522\Debug\BrowseInfo\main.c.json
    rspfile_name = D$:\STM32_ARM_IAR\Project260522\Debug\compile_commands.json.rsp

